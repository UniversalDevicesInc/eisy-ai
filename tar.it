#!/bin/sh
version=$(cat version.py | awk -F'=' '{print $2}' | sed 's/\"//g')

tar -czvf eisyai-${version}.tar.gz \
EisyAINode.py \
EisyaiControllerNode.py \
LICENSE.md \
POLYGLOT_CONFIG.md \
README.md \
eisyai.iox_plugin.json \
eisyai.py \
install.sh \
mcp_proxy \
profile \
provider_map.json \
provider_map.py \
requirements.txt \
constraints.txt \
start_eisyai.py \
version.py
